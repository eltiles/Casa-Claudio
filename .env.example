# Crea la BD antes de migrar:  createdb gestion_bar   (o CREATE DATABASE gestion_bar;)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gestion_bar?schema=public"
AUTH_SECRET="cambia-esto-por-un-secreto-aleatorio-largo"
AUTH_TRUST_HOST=true
INTERNAL_SECRET="secreto-para-el-endpoint-de-drain-del-outbox"


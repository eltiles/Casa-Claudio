generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  WAITER
  ACCOUNTANT
}

enum InvoiceKind {
  SIMPLIFIED
  COMPLETE
  RECTIFICATIVE
}

enum DocumentStatus {
  ISSUED
  RECTIFIED
}

enum PaymentMethod {
  CASH
  CARD
  BIZUM
  CONTACTLESS
  OTHER
}

enum SaleStatus {
  OPEN
  PAID
  VOID
}

enum TableStatus {
  FREE
  OCCUPIED
  PENDING_PAYMENT
}

enum OrderStatus {
  OPEN
  SENT_TO_KITCHEN
  SERVED
  CLOSED
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

enum EntrySource {
  SALE
  PURCHASE
  CASH_CLOSING
  MANUAL
}

enum OutboxStatus {
  PENDING
  PROCESSED
  FAILED
}

enum MovementType {
  IN
  OUT
  ADJUSTMENT
}

model Establishment {
  id           String   @id @default(cuid())
  name         String
  nif          String   @unique
  address      String
  postalCode   String
  municipality String
  province     String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  users            User[]
  series           InvoiceSeries[]
  invoices         Invoice[]
  categories       Category[]
  products         Product[]
  sales            Sale[]
  tables           DiningTable[]
  orders           Order[]
  cashClosings     CashClosing[]
  ledgerAccounts   LedgerAccount[]
  ledgerEntries    LedgerEntry[]
  stockItems       StockItem[]
  suppliers        Supplier[]
  purchaseInvoices PurchaseInvoice[]
  shifts           Shift[]
}

model User {
  id              String        @id @default(cuid())
  establishmentId String
  establishment   Establishment @relation(fields: [establishmentId], references: [id])
  email           String        @unique
  name            String
  passwordHash    String
  pinHash         String?
  pinLookup       String?       @unique
  role            Role          @default(WAITER)
  active          Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  salesAsWaiter      Sale[]         @relation("SaleWaiter")
  payments           Payment[]
  closingsOpened     CashClosing[]  @relation("ClosingOpenedBy")
  closingsClosed     CashClosing[]  @relation("ClosingClosedBy")
  ledgerEntries      LedgerEntry[]
  auditLogs          AuditLog[]
  shifts             Shift[]
}

model AuditLog {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id])
  action     String
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  ip         String?
  userAgent  String?
}

model TaxRate {
  id         String    @id @default(cuid())
  code       String
  label      String
  rate       Decimal   @db.Decimal(6, 4)
  validFrom  DateTime
  validTo    DateTime?
  active     Boolean   @default(true)

  products     Product[]
  invoiceLines InvoiceLine[]
  saleLines    SaleLine[]

  @@unique([code, validFrom])
}

model InvoiceSeries {
  id              String        @id @default(cuid())
  establishmentId String
  establishment   Establishment @relation(fields: [establishmentId], references: [id])
  code            String
  description     String?
  year            Int
  nextNumber      Int           @default(1)

  invoices Invoice[]

  @@unique([establishmentId, code, year])
}

model Invoice {
  id              String         @id @default(cuid())
  establishmentId String
  establishment   Establishment  @relation(fields: [establishmentId], references: [id])
  seriesId        String
  series          InvoiceSeries  @relation(fields: [seriesId], references: [id])
  seriesCode      String
  number          Int
  kind            InvoiceKind
  issueDate       DateTime       @default(now())
  customerNif     String?
  customerName    String?
  rectifiesId     String?
  rectifies       Invoice?       @relation("Rectification", fields: [rectifiesId], references: [id])
  rectifications  Invoice[]      @relation("Rectification")
  status          DocumentStatus @default(ISSUED)
  baseByRate      Json
  totalBase       Decimal        @db.Decimal(12, 2)
  totalTax        Decimal        @db.Decimal(12, 2)
  total           Decimal        @db.Decimal(12, 2)
  previousHash    String?
  hash            String         @unique
  verifactuStatus String?
  pdfUrl          String?
  saleId          String?        @unique
  sale            Sale?          @relation("InvoiceSale", fields: [saleId], references: [id])
  createdAt       DateTime       @default(now())

  lines InvoiceLine[]

  @@unique([seriesId, number])
}

model InvoiceLine {
  id          String  @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id])
  productId   String?
  product     Product? @relation(fields: [productId], references: [id])
  description String
  quantity    Decimal @db.Decimal(10, 3)
  unitPrice   Decimal @db.Decimal(12, 2)
  taxRateId   String
  taxRate     TaxRate @relation(fields: [taxRateId], references: [id])
  taxRatePct  Decimal @db.Decimal(6, 4)
  baseAmount  Decimal @db.Decimal(12, 2)
  taxAmount   Decimal @db.Decimal(12, 2)
  totalAmount Decimal @db.Decimal(12, 2)
}

model Category {
  id              String        @id @default(cuid())
  establishmentId String
  establishment   Establishment @relation(fields: [establishmentId], references: [id])
  name            String
  commissionPct   Decimal?      @db.Decimal(5, 2)

  products Product[]
}

model Product {
  id              String        @id @default(cuid())
  establishmentId String
  establishment   Establishment @relation(fields: [establishmentId], references: [id])
  categoryId      String
  category        Category      @relation(fields: [categoryId], references: [id])
  name            String
  sku             String
  taxRateId       String
  taxRate         TaxRate       @relation(fields: [taxRateId], references: [id])
  price           Decimal       @db.Decimal(12, 2)
  costStd         Decimal       @db.Decimal(12, 2) @default(0)
  saleAccountCode String        @default("700")
  active          Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  saleLines    SaleLine[]
  invoiceLines InvoiceLine[]
  orderLines   OrderLine[]
  recipe       Recipe?

  @@unique([establishmentId, sku])
}

model Sale {
  id              String     @id @default(cuid())
  establishmentId String
  establishment   Establishment @relation(fields: [establishmentId], references: [id])
  idempotencyKey  String     @unique
  number          String
  status          SaleStatus @default(OPEN)
  tableId         String?
  table           DiningTable? @relation(fields: [tableId], references: [id])
  waiterId        String?
  waiter          User?      @relation("SaleWaiter", fields: [waiterId], references: [id])
  openedAt        DateTime   @default(now())
  closedAt        DateTime?
  totalBase       Decimal    @db.Decimal(12, 2) @default(0)
  totalTax        Decimal    @db.Decimal(12, 2) @default(0)
  total           Decimal    @db.Decimal(12, 2) @default(0)
  createdAt       DateTime   @default(now())

  lines    SaleLine[]
  payments Payment[]
  orders   Order[]
  invoice  Invoice?  @relation("InvoiceSale")
}

model SaleLine {
  id          String  @id @default(cuid())
  saleId      String
  sale        Sale    @relation(fields: [saleId], references: [id])
  productId   String
  product     Product @relation(fields: [productId], references: [id])
  description String
  quantity    Decimal @db.Decimal(10, 3)
  unitPrice   Decimal @db.Decimal(12, 2)
  taxRateId   String
  taxRate     TaxRate @relation(fields: [taxRateId], references: [id])
  taxRatePct  Decimal @db.Decimal(6, 4)
  baseAmount  Decimal @db.Decimal(12, 2)
  taxAmount   Decimal @db.Decimal(12, 2)
  totalAmount Decimal @db.Decimal(12, 2)
  sentToKitchenAt DateTime?
}

model Payment {
  id        String        @id @default(cuid())
  saleId    String
  sale      Sale          @relation(fields: [saleId], references: [id])
  method    PaymentMethod
  amount    Decimal       @db.Decimal(12, 2)
  reference String?
  createdAt DateTime      @default(now())
  createdBy String?
  user      User?         @relation(fields: [createdBy], references: [id])
}

model DiningTable {
  id              String        @id @default(cuid())
  establishmentId String
  establishment   Establishment @relation(fields: [establishmentId], references: [id])
  name            String
  capacity        Int           @default(4)
  status          TableStatus   @default(FREE)

  sales  Sale[]
  orders Order[]
}

model Order {
  id              String        @id @default(cuid())
  establishmentId String
  establishment   Establishment @relation(fields: [establishmentId], references: [id])
  tableId         String?
  table           DiningTable?  @relation(fields: [tableId], references: [id])
  saleId          String?
  sale            Sale?         @relation(fields: [saleId], references: [id])
  status          OrderStatus   @default(OPEN)
  sentAt          DateTime?
  createdAt       DateTime      @default(now())

  lines OrderLine[]
}

model OrderLine {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Decimal @db.Decimal(10, 3)
  note      String?
  status    String  @default("PENDING")
}

model CashClosing {
  id              String        @id @default(cuid())
  establishmentId String
  establishment   Establishment @relation(fields: [establishmentId], references: [id])
  date            DateTime      @db.Date
  status          String        @default("OPEN")
  openingFloat    Decimal       @db.Decimal(12, 2) @default(0)
  expectedCash    Decimal       @db.Decimal(12, 2) @default(0)
  countedCash     Decimal?      @db.Decimal(12, 2)
  difference      Decimal?      @db.Decimal(12, 2)
  byMethod        Json?
  notes           String?
  openedById      String?
  openedBy        User?         @relation("ClosingOpenedBy", fields: [openedById], references: [id])
  closedById      String?
  closedBy        User?         @relation("ClosingClosedBy", fields: [closedById], references: [id])
  openedAt        DateTime      @default(now())
  closedAt        DateTime?

  @@unique([establishmentId, date])
}

model LedgerAccount {
  id              String        @id @default(cuid())
  establishmentId String
  establishment   Establishment @relation(fields: [establishmentId], references: [id])
  code            String
  name            String
  type            AccountType
  isSystem        Boolean       @default(false)

  lines LedgerEntryLine[]

  @@unique([establishmentId, code])
}

model LedgerEntry {
  id              String        @id @default(cuid())
  establishmentId String
  establishment   Establishment @relation(fields: [establishmentId], references: [id])
  number          Int
  date            DateTime      @db.Date
  description     String
  source          EntrySource
  sourceId        String?
  postedAt        DateTime      @default(now())
  postedById      String?
  postedBy        User?         @relation(fields: [postedById], references: [id])

  lines LedgerEntryLine[]

  @@unique([establishmentId, number])
}

model LedgerEntryLine {
  id          String        @id @default(cuid())
  entryId     String
  entry       LedgerEntry   @relation(fields: [entryId], references: [id])
  accountId   String
  account     LedgerAccount @relation(fields: [accountId], references: [id])
  debit       Decimal       @db.Decimal(12, 2) @default(0)
  credit      Decimal       @db.Decimal(12, 2) @default(0)
  taxRateId   String?
  description String?
}

model OutboxEvent {
  id            String       @id @default(cuid())
  aggregateType String
  aggregateId   String
  eventType     String
  payload       Json
  occurredAt    DateTime     @default(now())
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  processedAt   DateTime?
}

model StockItem {
  id              String   @id @default(cuid())
  establishmentId String
  establishment   Establishment @relation(fields: [establishmentId], references: [id])
  name            String
  sku             String
  unit            String
  quantity        Decimal  @db.Decimal(12, 3) @default(0)
  minStock        Decimal  @db.Decimal(12, 3) @default(0)
  unitCost        Decimal  @db.Decimal(12, 4) @default(0)
  active          Boolean  @default(true)

  movements     StockMovement[]
  recipeLines   RecipeLine[]
  purchaseLines PurchaseInvoiceLine[]

  @@unique([establishmentId, sku])
}

model StockMovement {
  id          String       @id @default(cuid())
  stockItemId String
  stockItem   StockItem    @relation(fields: [stockItemId], references: [id])
  type        MovementType
  quantity    Decimal      @db.Decimal(12, 3)
  reference   String?
  createdAt   DateTime     @default(now())
}

model Recipe {
  id        String       @id @default(cuid())
  productId String       @unique
  product   Product      @relation(fields: [productId], references: [id])

  lines RecipeLine[]
}

model RecipeLine {
  id          String    @id @default(cuid())
  recipeId    String
  recipe      Recipe    @relation(fields: [recipeId], references: [id])
  stockItemId String
  stockItem   StockItem @relation(fields: [stockItemId], references: [id])
  quantity    Decimal   @db.Decimal(12, 3)
}

model Supplier {
  id              String   @id @default(cuid())
  establishmentId String
  establishment   Establishment @relation(fields: [establishmentId], references: [id])
  name            String
  nif             String?

  invoices PurchaseInvoice[]
}

model PurchaseInvoice {
  id              String   @id @default(cuid())
  establishmentId String
  establishment   Establishment @relation(fields: [establishmentId], references: [id])
  supplierId      String
  supplier        Supplier @relation(fields: [supplierId], references: [id])
  number          String
  issueDate       DateTime
  totalBase       Decimal  @db.Decimal(12, 2)
  totalTax        Decimal  @db.Decimal(12, 2)
  total           Decimal  @db.Decimal(12, 2)
  ocrRawText      String?
  ocrConfidence   Decimal? @db.Decimal(5, 4)
  status          String   @default("DRAFT")
  createdAt       DateTime @default(now())

  lines PurchaseInvoiceLine[]

  @@unique([supplierId, number])
}

model PurchaseInvoiceLine {
  id                String           @id @default(cuid())
  purchaseInvoiceId String
  purchaseInvoice   PurchaseInvoice  @relation(fields: [purchaseInvoiceId], references: [id])
  stockItemId       String?
  stockItem         StockItem?       @relation(fields: [stockItemId], references: [id])
  description       String
  quantity          Decimal          @db.Decimal(10, 3)
  unitCost          Decimal          @db.Decimal(12, 4)
  taxRatePct        Decimal          @db.Decimal(6, 4)
  baseAmount        Decimal          @db.Decimal(12, 2)
  taxAmount         Decimal          @db.Decimal(12, 2)
}

model Shift {
  id              String   @id @default(cuid())
  establishmentId String
  establishment   Establishment @relation(fields: [establishmentId], references: [id])
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  start           DateTime
  end             DateTime?
  breakMinutes    Int      @default(0)
}
